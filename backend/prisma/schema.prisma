generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  ADMIN
  USER
}

enum PartnerType {
  COMPANY
  PERSON
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityEntityType {
  PARTNER
  CONTACT
  PROJECT
  TASK
  DOCUMENT
  OFFER
  LEAD
  FOLLOW_UP
  INCOMING_INVOICE
}

enum ActivityAction {
  CREATED
  UPDATED
  DELETED
  STATUS_CHANGED
  ASSIGNED
  PRIORITY_CHANGED
  PIPELINE_STAGE_CHANGED
  FOLLOW_UP_COMPLETED
  LEAD_CONVERTED
  DOCUMENT_ATTACHED
  DOCUMENT_REMOVED
}

enum ModuleKey {
  PARTNERS

  PROJECTS
  TASKS
  DOCUMENTS
  OFFERS

  LEADS
  PIPELINE
  FOLLOW_UPS
  INCOMING_INVOICES

  LOCATIONS
  DEVICES
  WORK_ORDERS
  MAINTENANCE
}

enum PermissionKey {
  PARTNERS_VIEW
  PARTNERS_CREATE
  PARTNERS_EDIT
  PARTNERS_DELETE

  PROJECTS_VIEW
  PROJECTS_CREATE
  PROJECTS_EDIT
  PROJECTS_DELETE

  TASKS_VIEW
  TASKS_CREATE
  TASKS_EDIT
  TASKS_DELETE
  TASKS_ASSIGN

  DOCUMENTS_VIEW
  DOCUMENTS_CREATE
  DOCUMENTS_EDIT
  DOCUMENTS_DELETE
  DOCUMENTS_DOWNLOAD

  INCOMING_INVOICES_VIEW
  INCOMING_INVOICES_CREATE
  INCOMING_INVOICES_EDIT
  INCOMING_INVOICES_DELETE

  OFFERS_VIEW
  OFFERS_CREATE
  OFFERS_EDIT
  OFFERS_DELETE

  LEADS_VIEW
  LEADS_CREATE
  LEADS_EDIT
  LEADS_DELETE
  LEADS_CONVERT

  PIPELINE_VIEW
  PIPELINE_CREATE
  PIPELINE_EDIT
  PIPELINE_DELETE

  FOLLOW_UPS_VIEW
  FOLLOW_UPS_CREATE
  FOLLOW_UPS_EDIT
  FOLLOW_UPS_DELETE
  FOLLOW_UPS_COMPLETE

  ACTIVITY_VIEW

  CUSTOM_FIELDS_VIEW
  CUSTOM_FIELDS_CREATE
  CUSTOM_FIELDS_EDIT
  CUSTOM_FIELDS_DELETE
}

enum DocumentEntityType {
  PARTNER
  PROJECT
  OFFER
  INCOMING_INVOICE
}

enum IncomingInvoiceStatus {
  DRAFT
  RECEIVED
  APPROVED
  PAID
  REJECTED
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}


enum CustomFieldEntityType {
  LEAD
  PARTNER
}

enum CustomFieldType {
  TEXT
  TEXTAREA
  NUMBER
  MONEY
  BOOLEAN
  DATE
  DATETIME
  SELECT
  MULTI_SELECT
}

model Organization {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  members     OrganizationMember[]
  partners    Partner[]
  projects    Project[]
  invitations Invitation[]
  modules     OrganizationModule[]
  tasks       Task[]
  activities  Activity[]
  documents   Document[]
  offers      Offer[]
  offerSequences OfferSequence[]
  leads       Lead[]
  pipelines   Pipeline[]
  pipelinePositions LeadPipelinePosition[]
  followUps         FollowUp[]
  customFields      CustomField[]
  customFieldValues CustomFieldValue[]
  listPreferences EntityListPreference[]
  documentLinks DocumentLink[]
  incomingInvoices IncomingInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           Int    @id @default(autoincrement())
  email        String @unique
  passwordHash String
  firstName    String
  lastName     String

  memberships OrganizationMember[]
  sessions    Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrganizationMember {
  id             Int              @id @default(autoincrement())
  userId         Int
  organizationId Int
  role           OrganizationRole @default(USER)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTasks Task[]
  activities    Activity[]
  permissions   OrganizationMemberPermission[]
  uploadedDocuments Document[]
  createdOffers Offer[]
  assignedLeads Lead[] @relation("LeadAssignee")
  createdLeads Lead[] @relation("LeadCreator")
  convertedLeads Lead[] @relation("LeadConverter")
  assignedFollowUps FollowUp[] @relation("FollowUpAssignee")
  createdFollowUps FollowUp[] @relation("FollowUpCreator")
  listPreferences EntityListPreference[]
  createdIncomingInvoices IncomingInvoice[] @relation("IncomingInvoiceCreator")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model OrganizationMemberPermission {
  id Int @id @default(autoincrement())

  organizationMemberId Int
  organizationMember   OrganizationMember @relation(fields: [organizationMemberId], references: [id], onDelete: Cascade)

  permission PermissionKey
  createdAt  DateTime @default(now())

  @@unique([organizationMemberId, permission])
  @@index([organizationMemberId])
}

model OrganizationModule {
  id Int @id @default(autoincrement())

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  module   ModuleKey
  enabled  Boolean   @default(true)
  settings Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, module])
  @@index([organizationId])
}

model Session {
  id               String @id @default(cuid())
  refreshTokenHash String @unique

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  expiresAt  DateTime?

  @@index([userId])
}

model Invitation {
  id        Int    @id @default(autoincrement())
  tokenHash String @unique

  email String?
  role  OrganizationRole @default(USER)

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([organizationId])
}

model Partner {
  id Int @id @default(autoincrement())

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type PartnerType @default(COMPANY)

  name      String
  email     String?
  phone     String?
  website   String?
  taxNumber String?
  address   String?
  note      String?

  contacts Contact[]
  projects Project[]
  offers   Offer[]
  convertedLeads Lead[] @relation("LeadConvertedPartner")
  incomingInvoices IncomingInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, name])
  @@unique([id, organizationId])
}

model Contact {
  id Int @id @default(autoincrement())

  firstName String
  lastName  String
  email     String?
  phone     String?
  position  String?
  note      String?

  partnerId Int
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerId])
}

model Project {
  id Int @id @default(autoincrement())

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  partnerId Int?
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  name        String
  description String?
  status      ProjectStatus @default(PLANNED)
  startDate   DateTime?
  deadline    DateTime?
  tasks       Task[]
  offers      Offer[]
  incomingInvoices IncomingInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([partnerId])
  @@index([organizationId, status])
  @@unique([id, organizationId])
}

model Task {
  id             Int                 @id @default(autoincrement())
  organizationId Int
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      Int?
  project        Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assigneeMemberId Int?
  assigneeMember   OrganizationMember? @relation(fields: [assigneeMemberId], references: [id], onDelete: SetNull)
  title          String
  description    String?
  status         TaskStatus          @default(TODO)
  priority       TaskPriority        @default(MEDIUM)
  dueDate        DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId])
  @@index([projectId])
  @@index([assigneeMemberId])
  @@index([organizationId, status])
  @@index([organizationId, priority])
}

model Activity {
  id             Int                 @id @default(autoincrement())
  organizationId Int
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorMemberId  Int?
  actorMember    OrganizationMember? @relation(fields: [actorMemberId], references: [id], onDelete: SetNull)
  entityType     ActivityEntityType
  entityId       Int
  action         ActivityAction
  title          String
  description    String?
  metadata       Json?
  createdAt      DateTime            @default(now())

  @@index([organizationId])
  @@index([organizationId, entityType, entityId])
  @@index([actorMemberId])
  @@index([createdAt])
}

model Document {
  id             Int                 @id @default(autoincrement())
  organizationId Int
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  originalFileName String
  mimeType       String
  size           Int
  storageKey     String
  documentType   String               @default("GENERAL") @map("category")
  description    String?              @map("note")
  uploadedByMemberId Int?
  uploadedByMember OrganizationMember? @relation(fields: [uploadedByMemberId], references: [id], onDelete: SetNull)
  links          DocumentLink[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId])
  @@index([organizationId, documentType])
  @@index([uploadedByMemberId])
  @@index([createdAt])
  @@unique([id, organizationId])
}

model DocumentLink {
  id             Int                @id @default(autoincrement())
  organizationId Int
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentId Int
  document   Document           @relation(fields: [documentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  entityType DocumentEntityType
  entityId   Int
  createdAt  DateTime           @default(now())

  @@unique([documentId, entityType, entityId])
  @@index([organizationId, entityType, entityId])
  @@index([documentId])
}

model IncomingInvoice {
  id                  Int                   @id @default(autoincrement())
  organizationId      Int
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierPartnerId   Int
  supplierPartner     Partner               @relation(fields: [supplierPartnerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  projectId           Int?
  project             Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  invoiceNumber       String
  issueDate           DateTime              @db.Date
  performanceDate     DateTime?             @db.Date
  dueDate             DateTime?             @db.Date
  currency            String                @default("HUF") @db.VarChar(3)
  netAmount           Decimal               @db.Decimal(18, 2)
  vatAmount           Decimal               @db.Decimal(18, 2)
  grossAmount         Decimal               @db.Decimal(18, 2)
  status              IncomingInvoiceStatus @default(DRAFT)
  note                String?
  createdByMemberId   Int?
  createdByMember     OrganizationMember?   @relation("IncomingInvoiceCreator", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@unique([organizationId, supplierPartnerId, invoiceNumber])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, supplierPartnerId])
  @@index([organizationId, dueDate])
  @@index([projectId, organizationId])
  @@index([createdByMemberId, organizationId])
}

model Offer {
  id                Int                 @id @default(autoincrement())
  organizationId    Int
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  offerNumber       String
  partnerId         Int
  partner           Partner             @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  projectId         Int?
  project           Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  status            OfferStatus         @default(DRAFT)
  issueDate         DateTime             @db.Date
  validUntil        DateTime             @db.Date
  currency          String               @default("HUF") @db.VarChar(3)
  note              String?
  createdByMemberId Int?
  createdByMember   OrganizationMember? @relation(fields: [createdByMemberId], references: [id], onDelete: SetNull)
  items             OfferItem[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([organizationId, offerNumber])
  @@index([organizationId])
  @@index([partnerId])
  @@index([projectId])
  @@index([organizationId, status])
  @@index([createdByMemberId])
}

model OfferItem {
  id          Int      @id @default(autoincrement())
  offerId     Int
  offer       Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  quantity    Decimal  @db.Decimal(18, 4)
  unit        String   @db.VarChar(32)
  unitPrice   Decimal  @db.Decimal(18, 2)
  vatRate     Decimal  @db.Decimal(5, 2)
  position    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([offerId, position])
}

model OfferSequence {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  year           Int
  lastNumber     Int          @default(0)
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, year])
  @@index([organizationId])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  LOST
}
enum LeadSource {
  WEBSITE
  REFERRAL
  PHONE
  EMAIL
  SOCIAL
  OTHER
}
model Lead {
  id Int @id @default(autoincrement())
  organizationId Int
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name String
  companyName String?
  email String?
  phone String?
  status LeadStatus @default(NEW)
  source LeadSource @default(OTHER)
  note String?
  assignedMemberId Int?
  assignedMember OrganizationMember? @relation("LeadAssignee", fields: [assignedMemberId], references: [id], onDelete: SetNull)
  createdByMemberId Int?
  createdByMember OrganizationMember? @relation("LeadCreator", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  convertedAt DateTime? @db.Timestamptz(3)
  convertedPartnerId Int?
  convertedPartner Partner? @relation("LeadConvertedPartner", fields: [convertedPartnerId, organizationId], references: [id, organizationId], onDelete: SetNull)
  convertedByMemberId Int?
  convertedByMember OrganizationMember? @relation("LeadConverter", fields: [convertedByMemberId, organizationId], references: [id, organizationId], onDelete: SetNull)
  pipelinePosition LeadPipelinePosition?
  followUps FollowUp[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, source])
  @@index([organizationId, assignedMemberId])
  @@unique([id, organizationId])
  @@index([assignedMemberId])
  @@index([createdByMemberId])
  @@index([convertedPartnerId, organizationId])
  @@index([convertedByMemberId, organizationId])
}

model Pipeline {
  id Int @id @default(autoincrement())
  organizationId Int
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name String
  isDefault Boolean @default(false)
  stages PipelineStage[]
  leadPositions LeadPipelinePosition[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, organizationId])
  @@index([organizationId])
}

model PipelineStage {
  id Int @id @default(autoincrement())
  organizationId Int
  pipelineId Int
  pipeline Pipeline @relation(fields: [pipelineId, organizationId], references: [id, organizationId], onDelete: Cascade)
  name String
  position Int
  leadPositions LeadPipelinePosition[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, pipelineId, organizationId])
  @@unique([pipelineId, position])
  @@index([organizationId])
}

model LeadPipelinePosition {
  id Int @id @default(autoincrement())
  organizationId Int
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId Int @unique
  lead Lead @relation(fields: [leadId, organizationId], references: [id, organizationId], onDelete: Cascade)
  pipelineId Int
  pipeline Pipeline @relation(fields: [pipelineId, organizationId], references: [id, organizationId], onDelete: Restrict)
  pipelineStageId Int
  pipelineStage PipelineStage @relation(fields: [pipelineStageId, pipelineId, organizationId], references: [id, pipelineId, organizationId], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, pipelineId])
  @@unique([leadId, organizationId])
  @@index([pipelineStageId, pipelineId, organizationId])
}

enum FollowUpType {
  CALL
  EMAIL
  MEETING
  OTHER
}

enum FollowUpStatus {
  OPEN
  COMPLETED
  CANCELLED
}

model FollowUp {
  id Int @id @default(autoincrement())
  organizationId Int
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId Int
  lead Lead @relation(fields: [leadId, organizationId], references: [id, organizationId], onDelete: Cascade)
  assignedMemberId Int?
  assignedMember OrganizationMember? @relation("FollowUpAssignee", fields: [assignedMemberId, organizationId], references: [id, organizationId], onDelete: SetNull)
  createdByMemberId Int?
  createdByMember OrganizationMember? @relation("FollowUpCreator", fields: [createdByMemberId, organizationId], references: [id, organizationId], onDelete: SetNull)
  type FollowUpType @default(OTHER)
  status FollowUpStatus @default(OPEN)
  dueAt DateTime @db.Timestamptz(3)
  note String?
  completedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([organizationId, status, dueAt])
  @@index([organizationId, assignedMemberId, status, dueAt])
  @@index([leadId, organizationId, status, dueAt])
  @@index([assignedMemberId, organizationId])
  @@index([createdByMemberId, organizationId])
}

model CustomField {
  id             Int                   @id @default(autoincrement())
  organizationId Int
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType     CustomFieldEntityType
  key            String
  label          String
  fieldType      CustomFieldType
  required       Boolean               @default(false)
  active         Boolean               @default(true)
  sortOrder      Int                   @default(0)
  placeholder    String?
  helpText       String?
  defaultValue   String?
  options        Json?
  values         CustomFieldValue[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([organizationId, entityType, key])
  @@index([organizationId, entityType, active])
}

model CustomFieldValue {
  id             Int                   @id @default(autoincrement())
  organizationId Int
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customFieldId  Int
  customField    CustomField           @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  entityType     CustomFieldEntityType
  entityId       Int
  value          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([customFieldId, entityId])
  @@index([organizationId, entityType, entityId])
  @@index([customFieldId])
}

model EntityListPreference {
  id                   Int                   @id @default(autoincrement())
  organizationId       Int
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationMemberId Int
  organizationMember   OrganizationMember    @relation(fields: [organizationMemberId, organizationId], references: [id, organizationId], onDelete: Cascade)
  entityType            CustomFieldEntityType
  version               Int                   @default(1)
  columns               Json
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@unique([organizationMemberId, entityType])
  @@index([organizationId, entityType])
  @@index([organizationMemberId, organizationId])
}
