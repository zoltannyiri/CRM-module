generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  ADMIN
  USER
}

enum PartnerType {
  COMPANY
  PERSON
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityEntityType {
  PARTNER
  CONTACT
  PROJECT
  TASK
}

enum ActivityAction {
  CREATED
  UPDATED
  DELETED
  STATUS_CHANGED
  ASSIGNED
  PRIORITY_CHANGED
}

enum ModuleKey {
  PARTNERS

  PROJECTS
  TASKS
  DOCUMENTS
  QUOTES

  LEADS
  PIPELINE
  FOLLOW_UPS

  LOCATIONS
  DEVICES
  WORK_ORDERS
  MAINTENANCE
}

model Organization {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  members     OrganizationMember[]
  partners    Partner[]
  projects    Project[]
  invitations Invitation[]
  modules     OrganizationModule[]
  tasks       Task[]
  activities  Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           Int    @id @default(autoincrement())
  email        String @unique
  passwordHash String
  firstName    String
  lastName     String

  memberships OrganizationMember[]
  sessions    Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrganizationMember {
  id             Int              @id @default(autoincrement())
  userId         Int
  organizationId Int
  role           OrganizationRole @default(USER)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTasks Task[]
  activities    Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model OrganizationModule {
  id Int @id @default(autoincrement())

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  module   ModuleKey
  enabled  Boolean   @default(true)
  settings Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, module])
  @@index([organizationId])
}

model Session {
  id               String @id @default(cuid())
  refreshTokenHash String @unique

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  expiresAt  DateTime?

  @@index([userId])
}

model Invitation {
  id        Int    @id @default(autoincrement())
  tokenHash String @unique

  email String?
  role  OrganizationRole @default(USER)

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([organizationId])
}

model Partner {
  id Int @id @default(autoincrement())

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type PartnerType @default(COMPANY)

  name      String
  email     String?
  phone     String?
  website   String?
  taxNumber String?
  address   String?
  note      String?

  contacts Contact[]
  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, name])
}

model Contact {
  id Int @id @default(autoincrement())

  firstName String
  lastName  String
  email     String?
  phone     String?
  position  String?
  note      String?

  partnerId Int
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerId])
}

model Project {
  id Int @id @default(autoincrement())

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  partnerId Int?
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  name        String
  description String?
  status      ProjectStatus @default(PLANNED)
  startDate   DateTime?
  deadline    DateTime?
  tasks       Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([partnerId])
  @@index([organizationId, status])
}

model Task {
  id             Int                 @id @default(autoincrement())
  organizationId Int
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      Int?
  project        Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assigneeMemberId Int?
  assigneeMember   OrganizationMember? @relation(fields: [assigneeMemberId], references: [id], onDelete: SetNull)
  title          String
  description    String?
  status         TaskStatus          @default(TODO)
  priority       TaskPriority        @default(MEDIUM)
  dueDate        DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId])
  @@index([projectId])
  @@index([assigneeMemberId])
  @@index([organizationId, status])
  @@index([organizationId, priority])
}

model Activity {
  id             Int                 @id @default(autoincrement())
  organizationId Int
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorMemberId  Int?
  actorMember    OrganizationMember? @relation(fields: [actorMemberId], references: [id], onDelete: SetNull)
  entityType     ActivityEntityType
  entityId       Int
  action         ActivityAction
  title          String
  description    String?
  metadata       Json?
  createdAt      DateTime            @default(now())

  @@index([organizationId])
  @@index([organizationId, entityType, entityId])
  @@index([actorMemberId])
  @@index([createdAt])
}
