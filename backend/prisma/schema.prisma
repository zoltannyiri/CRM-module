generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  ADMIN
  USER
}

enum PartnerType {
  COMPANY
  PERSON
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityEntityType {
  PARTNER
  CONTACT
  PROJECT
  TASK
  DOCUMENT
  OFFER
  LEAD
}

enum ActivityAction {
  CREATED
  UPDATED
  DELETED
  STATUS_CHANGED
  ASSIGNED
  PRIORITY_CHANGED
}

enum ModuleKey {
  PARTNERS

  PROJECTS
  TASKS
  DOCUMENTS
  OFFERS

  LEADS
  PIPELINE
  FOLLOW_UPS

  LOCATIONS
  DEVICES
  WORK_ORDERS
  MAINTENANCE
}

enum PermissionKey {
  PARTNERS_VIEW
  PARTNERS_CREATE
  PARTNERS_EDIT
  PARTNERS_DELETE

  PROJECTS_VIEW
  PROJECTS_CREATE
  PROJECTS_EDIT
  PROJECTS_DELETE

  TASKS_VIEW
  TASKS_CREATE
  TASKS_EDIT
  TASKS_DELETE
  TASKS_ASSIGN

  DOCUMENTS_VIEW
  DOCUMENTS_CREATE
  DOCUMENTS_EDIT
  DOCUMENTS_DELETE
  DOCUMENTS_DOWNLOAD

  OFFERS_VIEW
  OFFERS_CREATE
  OFFERS_EDIT
  OFFERS_DELETE

  LEADS_VIEW
  LEADS_CREATE
  LEADS_EDIT
  LEADS_DELETE

  ACTIVITY_VIEW
}

enum DocumentEntityType {
  PARTNER
  PROJECT
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

model Organization {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  members     OrganizationMember[]
  partners    Partner[]
  projects    Project[]
  invitations Invitation[]
  modules     OrganizationModule[]
  tasks       Task[]
  activities  Activity[]
  documents   Document[]
  offers      Offer[]
  offerSequences OfferSequence[]
  leads       Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           Int    @id @default(autoincrement())
  email        String @unique
  passwordHash String
  firstName    String
  lastName     String

  memberships OrganizationMember[]
  sessions    Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrganizationMember {
  id             Int              @id @default(autoincrement())
  userId         Int
  organizationId Int
  role           OrganizationRole @default(USER)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTasks Task[]
  activities    Activity[]
  permissions   OrganizationMemberPermission[]
  uploadedDocuments Document[]
  createdOffers Offer[]
  assignedLeads Lead[] @relation("LeadAssignee")
  createdLeads Lead[] @relation("LeadCreator")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model OrganizationMemberPermission {
  id Int @id @default(autoincrement())

  organizationMemberId Int
  organizationMember   OrganizationMember @relation(fields: [organizationMemberId], references: [id], onDelete: Cascade)

  permission PermissionKey
  createdAt  DateTime @default(now())

  @@unique([organizationMemberId, permission])
  @@index([organizationMemberId])
}

model OrganizationModule {
  id Int @id @default(autoincrement())

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  module   ModuleKey
  enabled  Boolean   @default(true)
  settings Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, module])
  @@index([organizationId])
}

model Session {
  id               String @id @default(cuid())
  refreshTokenHash String @unique

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  expiresAt  DateTime?

  @@index([userId])
}

model Invitation {
  id        Int    @id @default(autoincrement())
  tokenHash String @unique

  email String?
  role  OrganizationRole @default(USER)

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([organizationId])
}

model Partner {
  id Int @id @default(autoincrement())

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type PartnerType @default(COMPANY)

  name      String
  email     String?
  phone     String?
  website   String?
  taxNumber String?
  address   String?
  note      String?

  contacts Contact[]
  projects Project[]
  offers   Offer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, name])
}

model Contact {
  id Int @id @default(autoincrement())

  firstName String
  lastName  String
  email     String?
  phone     String?
  position  String?
  note      String?

  partnerId Int
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerId])
}

model Project {
  id Int @id @default(autoincrement())

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  partnerId Int?
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  name        String
  description String?
  status      ProjectStatus @default(PLANNED)
  startDate   DateTime?
  deadline    DateTime?
  tasks       Task[]
  offers      Offer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([partnerId])
  @@index([organizationId, status])
}

model Task {
  id             Int                 @id @default(autoincrement())
  organizationId Int
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      Int?
  project        Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assigneeMemberId Int?
  assigneeMember   OrganizationMember? @relation(fields: [assigneeMemberId], references: [id], onDelete: SetNull)
  title          String
  description    String?
  status         TaskStatus          @default(TODO)
  priority       TaskPriority        @default(MEDIUM)
  dueDate        DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId])
  @@index([projectId])
  @@index([assigneeMemberId])
  @@index([organizationId, status])
  @@index([organizationId, priority])
}

model Activity {
  id             Int                 @id @default(autoincrement())
  organizationId Int
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorMemberId  Int?
  actorMember    OrganizationMember? @relation(fields: [actorMemberId], references: [id], onDelete: SetNull)
  entityType     ActivityEntityType
  entityId       Int
  action         ActivityAction
  title          String
  description    String?
  metadata       Json?
  createdAt      DateTime            @default(now())

  @@index([organizationId])
  @@index([organizationId, entityType, entityId])
  @@index([actorMemberId])
  @@index([createdAt])
}

model Document {
  id             Int                 @id @default(autoincrement())
  organizationId Int
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  originalFileName String
  mimeType       String
  size           Int
  storageKey     String
  category       String?
  note           String?
  uploadedByMemberId Int?
  uploadedByMember OrganizationMember? @relation(fields: [uploadedByMemberId], references: [id], onDelete: SetNull)
  links          DocumentLink[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId])
  @@index([uploadedByMemberId])
  @@index([createdAt])
}

model DocumentLink {
  id         Int                @id @default(autoincrement())
  documentId Int
  document   Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  entityType DocumentEntityType
  entityId   Int
  createdAt  DateTime           @default(now())

  @@unique([documentId, entityType, entityId])
  @@index([entityType, entityId])
}

model Offer {
  id                Int                 @id @default(autoincrement())
  organizationId    Int
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  offerNumber       String
  partnerId         Int
  partner           Partner             @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  projectId         Int?
  project           Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  status            OfferStatus         @default(DRAFT)
  issueDate         DateTime             @db.Date
  validUntil        DateTime             @db.Date
  currency          String               @default("HUF") @db.VarChar(3)
  note              String?
  createdByMemberId Int?
  createdByMember   OrganizationMember? @relation(fields: [createdByMemberId], references: [id], onDelete: SetNull)
  items             OfferItem[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([organizationId, offerNumber])
  @@index([organizationId])
  @@index([partnerId])
  @@index([projectId])
  @@index([organizationId, status])
  @@index([createdByMemberId])
}

model OfferItem {
  id          Int      @id @default(autoincrement())
  offerId     Int
  offer       Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  quantity    Decimal  @db.Decimal(18, 4)
  unit        String   @db.VarChar(32)
  unitPrice   Decimal  @db.Decimal(18, 2)
  vatRate     Decimal  @db.Decimal(5, 2)
  position    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([offerId, position])
}

model OfferSequence {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  year           Int
  lastNumber     Int          @default(0)
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, year])
  @@index([organizationId])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  LOST
}
enum LeadSource {
  WEBSITE
  REFERRAL
  PHONE
  EMAIL
  SOCIAL
  OTHER
}
model Lead {
  id Int @id @default(autoincrement())
  organizationId Int
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name String
  companyName String?
  email String?
  phone String?
  status LeadStatus @default(NEW)
  source LeadSource @default(OTHER)
  note String?
  assignedMemberId Int?
  assignedMember OrganizationMember? @relation("LeadAssignee", fields: [assignedMemberId], references: [id], onDelete: SetNull)
  createdByMemberId Int?
  createdByMember OrganizationMember? @relation("LeadCreator", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, source])
  @@index([organizationId, assignedMemberId])
  @@index([assignedMemberId])
  @@index([createdByMemberId])
}
